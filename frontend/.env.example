# Frontend Configuration

# The URL of your Node.js Backend API
# For local dev: http://localhost:5000/api
# For production: https://ai-ambulance-dispatch-routing-x2lr.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# The URL of your Node.js Socket Server (usually the same base URL as API)
VITE_SOCKET_URL=http://localhost:5000

# Set to true to force demo mode (offline simulation)
# Set to false to force strict live backend requests
VITE_FORCE_DEMO=false
